{
  "name": "telegram-admin-server",
  "version": "0.0.2",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --module commonjs --outDir lib/cjs && babel lib/cjs --out-dir lib/cjs",
    "build:cjs-only": "tsc src/index.cjs.ts --outDir lib/cjs --module commonjs",
    "build:esm": "tsc --module esnext --outDir lib/esm",
    "build:types": "tsc --emitDeclarationOnly --outDir lib/types",
    "dev": "tsc --watch --noEmit",
    "link": "npm link",
    "pack": "npm run build && npm pack",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "joi": "^18.0.2",
    "telegraf": "^4.16.3"
  }
}
