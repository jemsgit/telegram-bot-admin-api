{
  "name": "telegraf-admin-for-bots",
  "version": "0.1.0",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev:build": "tsup --watch",
    "dev": "tsc --noEmit --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "yarn build && npm pack",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "eslint": "9",
    "globals": "^17.5.0",
    "telegraf": "^4.16.3",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^3"
  },
  "dependencies": {
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "joi": "^18.0.2"
  },
  "peerDependencies": {
    "telegraf": "^4.16.3"
  },
  "peerDependenciesMeta": {
    "telegraf": {
      "optional": false
    }
  },
  "packageManager": "yarn@4.1.1"
}
