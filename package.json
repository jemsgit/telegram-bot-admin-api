{
  "name": "telegraf-admin-for-bots",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jemsgit/telegram-bot-admin-api.git"
  },
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./ui-kit": {
      "import": {
        "types": "./lib/ui-kit/ui-kit.d.ts",
        "default": "./lib/ui-kit/index.mjs"
      },
      "require": {
        "types": "./lib/ui-kit/ui-kit.d.ts",
        "default": "./lib/ui-kit/index.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build": "tsup",
    "build:ui": "cd ui && npm run build:all",
    "build:all": "yarn clean && yarn build && yarn build:ui",
    "dev:build": "tsup --watch",
    "dev": "tsc --noEmit --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "yarn build && node scripts/generate-openapi.js",
    "pack": "yarn build:all && npm pack",
    "prepublishOnly": "yarn build:all"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "eslint": "9",
    "globals": "^17.5.0",
    "telegraf": "^4.16.3",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^3"
  },
  "dependencies": {
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "joi": "^18.0.2"
  },
  "peerDependencies": {
    "telegraf": "^4.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mantine/core": "^9.0.0",
    "@mantine/dates": "^9.0.0",
    "@mantine/form": "^9.0.0",
    "@mantine/hooks": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "telegraf": {
      "optional": false
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@mantine/core": {
      "optional": true
    },
    "@mantine/dates": {
      "optional": true
    },
    "@mantine/form": {
      "optional": true
    },
    "@mantine/hooks": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.1.1"
}
