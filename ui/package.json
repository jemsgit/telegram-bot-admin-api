{
  "name": "@telegraf-admin-for-bots/ui",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone web UI для createAdmin({ http: { ui: { enabled: true } } }) — см. ../docs/CUSTOMIZABLE_ADMIN_UI.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:kit": "tsc --noEmit && vite build --config vite.config.lib.ts",
    "build:all": "npm run build && npm run build:kit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^5.1.0"
  }
}
